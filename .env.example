# URL publique du site (SEO, liens des e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base locale par défaut. Pour PostgreSQL / Supabase plus tard :
# DATABASE_URL=postgresql://...
DATABASE_URL=

# Session admin (générer une valeur longue et aléatoire)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Compte administrateur créé au premier démarrage. Ne jamais committer ces valeurs.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Jeton optionnel pour une future application mobile : Authorization: Bearer ...
ADMIN_API_TOKEN=

# WhatsApp au format international, sans + ni espaces. Laisser vide tant que Laura ne l'a pas transmis.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# E-mail qui reçoit les nouvelles demandes. Laisser vide tant qu'il n'est pas validé.
ADMIN_NOTIFY_EMAIL=

# log | resend | sendgrid | brevo | smtp
EMAIL_PROVIDER=log
EMAIL_FROM=

RESEND_API_KEY=
SENDGRID_API_KEY=
BREVO_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
